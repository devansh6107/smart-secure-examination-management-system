# ──── MySQL Database Configuration ────
# Option 1: Local MySQL Development
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=exam_management_db
# DB_USER=root
# DB_PASSWORD=replace_with_local_password
# DB_SSL_REQUIRED=False

# Option 2: Remote Cloud MySQL (e.g. Aiven)
DB_HOST=exam-management-db-devanshghosh6107-9509.e.aivencloud.com
DB_PORT=18298
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace_with_your_aiven_password

# ──── SSL / TLS Configuration ────
# Required for cloud databases enforcing encrypted connections
DB_SSL_REQUIRED=True

# Path to the CA certificate (e.g., ca.pem downloaded from Aiven)
# On Vercel, this can also contain the raw PEM certificate text
DB_SSL_CA=ca.pem
DB_SSL_VERIFY_CERT=True

# ──── Flask Application Configuration ────
SECRET_KEY=replace_with_a_secure_random_value
FLASK_DEBUG=False
FLASK_PORT=5001
